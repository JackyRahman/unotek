{
  "swagger": "2.0",
  "info": {
    "title": "Unotek Enterprise Backend API",
    "description": "Enterprise Software House Backend Services with RBAC, PostgreSQL, Clean Architecture, and Master Data Management.",
    "version": "1.0.0",
    "termsOfService": "http://swagger.io/terms/",
    "contact": {
      "name": "API Support",
      "email": "dev@company.com"
    },
    "license": {
      "name": "MIT"
    }
  },
  "host": "localhost:8080",
  "basePath": "/",
  "schemes": [
    "http",
    "https"
  ],
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Enter your JWT token with the 'Bearer ' prefix, e.g. 'Bearer eyJhbGci...'"
    }
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Authenticate user and obtain JWT token",
        "description": "Login with username/email and password to receive access token",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "request",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["identifier", "password"],
              "properties": {
                "identifier": { "type": "string", "example": "admin@company.com" },
                "password": { "type": "string", "example": "admin12345" }
              }
            }
          }
        ],
        "responses": {
          "200": { "description": "Login Successful" },
          "400": { "description": "Bad Request / Validation Error" },
          "401": { "description": "Invalid Credentials" }
        }
      }
    },
    "/api/v1/auth/profile": {
      "get": {
        "security": [{ "BearerAuth": [] }],
        "tags": ["Authentication"],
        "summary": "Get current logged-in user profile",
        "produces": ["application/json"],
        "responses": {
          "200": { "description": "Profile Retrieved" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/v1/company/profile": {
      "get": {
        "tags": ["Company Info"],
        "summary": "Get company profile & brand information (Public)",
        "produces": ["application/json"],
        "responses": {
          "200": { "description": "Company Profile Retrieved" }
        }
      }
    },
    "/api/v1/company/offices": {
      "get": {
        "tags": ["Company Info"],
        "summary": "Get list of active office locations (Public)",
        "produces": ["application/json"],
        "responses": {
          "200": { "description": "Office locations list" }
        }
      }
    },
    "/api/v1/clients": {
      "get": {
        "tags": ["Clients"],
        "summary": "Get list of active clients (Public)",
        "produces": ["application/json"],
        "parameters": [
          { "type": "integer", "default": 1, "name": "page", "in": "query" },
          { "type": "integer", "default": 10, "name": "per_page", "in": "query" },
          { "type": "string", "name": "search", "in": "query" }
        ],
        "responses": {
          "200": { "description": "List of clients" }
        }
      }
    },
    "/api/v1/clients/{slug}": {
      "get": {
        "tags": ["Clients"],
        "summary": "Get client detail by slug (Public)",
        "produces": ["application/json"],
        "parameters": [
          { "type": "string", "name": "slug", "in": "path", "required": true }
        ],
        "responses": {
          "200": { "description": "Client detail" },
          "404": { "description": "Client not found" }
        }
      }
    },
    "/api/v1/partners": {
      "get": {
        "tags": ["Partners"],
        "summary": "Get list of active product & tech partners (Public)",
        "produces": ["application/json"],
        "parameters": [
          { "type": "integer", "default": 1, "name": "page", "in": "query" },
          { "type": "integer", "default": 10, "name": "per_page", "in": "query" },
          { "type": "string", "name": "search", "in": "query" }
        ],
        "responses": {
          "200": { "description": "List of partners" }
        }
      }
    },
    "/api/v1/solutions": {
      "get": {
        "tags": ["Solutions"],
        "summary": "Get list of solutions (Public)",
        "produces": ["application/json"],
        "parameters": [
          { "type": "integer", "default": 1, "name": "page", "in": "query" },
          { "type": "integer", "default": 10, "name": "per_page", "in": "query" },
          { "type": "string", "name": "search", "in": "query" }
        ],
        "responses": {
          "200": { "description": "List of solutions" }
        }
      }
    },
    "/api/v1/solutions/{slug}": {
      "get": {
        "tags": ["Solutions"],
        "summary": "Get solution detail by slug (Public)",
        "produces": ["application/json"],
        "parameters": [
          { "type": "string", "name": "slug", "in": "path", "required": true }
        ],
        "responses": {
          "200": { "description": "Solution Detail" },
          "404": { "description": "Solution Not Found" }
        }
      }
    },
    "/api/v1/team": {
      "get": {
        "tags": ["Team"],
        "summary": "Get list of team members (Public)",
        "produces": ["application/json"],
        "responses": {
          "200": { "description": "List of team members" }
        }
      }
    },
    "/api/v1/contact": {
      "post": {
        "tags": ["Contact Us"],
        "summary": "Submit a contact us message / lead (Public)",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "request",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["full_name", "email", "subject", "message"],
              "properties": {
                "full_name": { "type": "string", "example": "Budi Pratama" },
                "email": { "type": "string", "example": "budi@perusahaan.com" },
                "phone": { "type": "string", "example": "+628123456789" },
                "company_name": { "type": "string", "example": "PT Maju Logistik" },
                "service_interest": { "type": "string", "example": "Warehouse Management System (WMS)" },
                "subject": { "type": "string", "example": "Permintaan Demo WMS" },
                "message": { "type": "string", "example": "Halo tim, kami ingin menjadwalkan demo WMS." }
              }
            }
          }
        ],
        "responses": {
          "201": { "description": "Inquiry Submitted Successfully" },
          "400": { "description": "Validation Error" }
        }
      }
    },
    "/api/v1/admin/clients": {
      "get": {
        "security": [{ "BearerAuth": [] }],
        "tags": ["Admin - Clients"],
        "summary": "Get all clients with filters (Admin)",
        "responses": { "200": { "description": "Success" } }
      },
      "post": {
        "security": [{ "BearerAuth": [] }],
        "tags": ["Admin - Clients"],
        "summary": "Create a new client (Admin)",
        "parameters": [
          {
            "name": "request",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["name", "logo_url", "is_active"],
              "properties": {
                "name": { "type": "string", "example": "PT Logistik Jaya" },
                "slug": { "type": "string", "example": "logistik-jaya" },
                "industry": { "type": "string", "example": "Logistics" },
                "website_url": { "type": "string", "example": "https://logistikjaya.com" },
                "logo_url": { "type": "string", "example": "https://assets.com/logo.svg" },
                "description": { "type": "string" },
                "is_featured": { "type": "boolean", "example": true },
                "display_order": { "type": "integer", "example": 1 },
                "is_active": { "type": "boolean", "example": true }
              }
            }
          }
        ],
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/api/v1/admin/clients/{id}": {
      "get": {
        "security": [{ "BearerAuth": [] }],
        "tags": ["Admin - Clients"],
        "summary": "Get client detail by ID (Admin)",
        "parameters": [{ "type": "string", "name": "id", "in": "path", "required": true }],
        "responses": { "200": { "description": "Success" } }
      },
      "put": {
        "security": [{ "BearerAuth": [] }],
        "tags": ["Admin - Clients"],
        "summary": "Update an existing client (Admin)",
        "parameters": [
          { "type": "string", "name": "id", "in": "path", "required": true },
          { "name": "request", "in": "body", "required": true, "schema": { "type": "object" } }
        ],
        "responses": { "200": { "description": "Updated" } }
      },
      "delete": {
        "security": [{ "BearerAuth": [] }],
        "tags": ["Admin - Clients"],
        "summary": "Delete a client (Admin)",
        "parameters": [{ "type": "string", "name": "id", "in": "path", "required": true }],
        "responses": { "200": { "description": "Deleted" } }
      }
    },
    "/api/v1/admin/contacts": {
      "get": {
        "security": [{ "BearerAuth": [] }],
        "tags": ["Admin - Contacts"],
        "summary": "Get submitted contact messages / leads (Admin)",
        "parameters": [
          { "type": "string", "name": "status", "in": "query" }
        ],
        "responses": { "200": { "description": "Success" } }
      }
    },
    "/api/v1/admin/contacts/{id}/status": {
      "patch": {
        "security": [{ "BearerAuth": [] }],
        "tags": ["Admin - Contacts"],
        "summary": "Update inquiry status & notes (Admin)",
        "parameters": [
          { "type": "string", "name": "id", "in": "path", "required": true },
          {
            "name": "request",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["status"],
              "properties": {
                "status": { "type": "string", "example": "contacted" },
                "notes": { "type": "string", "example": "Sudah dihubungi oleh tim sales" }
              }
            }
          }
        ],
        "responses": { "200": { "description": "Status updated" } }
      }
    },
    "/api/v1/admin/rbac/roles": {
      "get": {
        "security": [{ "BearerAuth": [] }],
        "tags": ["Admin - RBAC"],
        "summary": "Get all system roles (Super Admin)",
        "responses": { "200": { "description": "List of roles" } }
      }
    },
    "/api/v1/admin/rbac/permissions": {
      "get": {
        "security": [{ "BearerAuth": [] }],
        "tags": ["Admin - RBAC"],
        "summary": "Get all available system permissions (Super Admin)",
        "responses": { "200": { "description": "List of permissions" } }
      }
    }
  }
}
